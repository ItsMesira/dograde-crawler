# ══════════════════════════════════════════════════════════════
#  Dograde Crawler — ไฟล์ที่ไม่ควรเข้า git
#  หลักการ: ความลับ + ข้อมูลส่วนตัว + ไฟล์ที่สร้างใหม่ = ห้าม commit
# ══════════════════════════════════════════════════════════════

# ── ความลับ ───────────────────────────────────────────────────
bot_config.json
.env
.env.*

# ── ข้อมูลส่วนตัว (วันเกิด = รหัสผ่านของเว็บ) ─────────────────
# กัน CSV/XLSX ทุกชื่อ แล้วยกเว้นเฉพาะไฟล์ตัวอย่างที่ไม่มีข้อมูลจริง
*.csv
*.xlsx
*.xls
!students.example.csv
students.csv
students.xlsx
allnuminorder.md
รายชื่อ*.csv
รายชื่อ*.xlsx
roster*.csv
roster*.xlsx

# ── ผลลัพธ์/หลักฐานจากการรัน ─────────────────────────────────
exports/
shots/
data/

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── ระบบปฏิบัติการ / โปรแกรมแก้ไข ────────────────────────────
.DS_Store
._*
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp

# ── log / ไฟล์ชั่วคราว ────────────────────────────────────────
*.log
*.tmp
*.bak
